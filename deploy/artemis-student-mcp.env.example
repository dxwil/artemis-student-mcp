# Copy to /etc/artemis-student-mcp.env and keep it mode 640, root:artemis-mcp.
# Do not put an Artemis username, password, session, or client bearer token in this file.
# Remote users sign in from their MCP client. This file only names the servers.

# Artemis origin. The browser sign-in page posts the password here once and does not store it.
ARTEMIS_BASE_URL=https://artemis.tum.de

# HTTP listener. Keep this on loopback and publish the whole site with a reverse proxy.
ARTEMIS_MCP_TRANSPORT=http
ARTEMIS_MCP_HOST=127.0.0.1
ARTEMIS_MCP_PORT=8080
ARTEMIS_MCP_STATE_DIR=/var/lib/artemis-student-mcp

# Public origin of the reverse proxy, with no path. This is the OAuth issuer.
# Replace the host with the domain clients will use, then restart the service.
ARTEMIS_MCP_PUBLIC_URL=https://mcp.example.com

# Extra browser origins, comma-separated. Native clients omit Origin and are allowed.
# ARTEMIS_MCP_ALLOWED_ORIGINS=

# Ask Artemis for a longer session. The password is still not stored.
# The first sign-in for an account can cause Artemis to email that account.
ARTEMIS_REMEMBER_ME=true
